# ==============================================================================
# FluxWarden Global Environment Configuration
# Project: Autonomous AI Incident Investigation, Recovery & Resilience Agent
# Participant: Pochiraju Kailash Ram Markandeya Sharma
# Team: kailashsharma8 | Hackathon: Tech Zephyr 4.0, IIT Bhubaneswar
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COGNITIVE AI & LLM PROVIDER SELECTION
# ------------------------------------------------------------------------------
# Choose one of: mock (default, 0 keys needed), gemini, openai, anthropic
LLM_PROVIDER=mock

# Google Gemini (Recommended for free tier live testing: https://aistudio.google.com/)
# When LLM_PROVIDER=gemini, provide your Gemini API key:
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
# When LLM_PROVIDER=openai, provide your OpenAI key:
OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/)
# When LLM_PROVIDER=anthropic, provide your Anthropic key:
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
DEBUG=True
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. DATABASE PERSISTENCE
# ------------------------------------------------------------------------------
# Local development default (zero configuration SQLite):
DATABASE_URL=sqlite+aiosqlite:///./fluxwarden.db

# Production PostgreSQL (e.g. Render / Neon / Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/fluxwarden

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & REALTIME STREAMING
# ------------------------------------------------------------------------------
# Optional: In-memory fallback is automatic if Redis is not running locally.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. AGENTIC STATE MACHINE BOUNDARIES & SAFETY CONTROLS
# ------------------------------------------------------------------------------
MAX_AGENT_STEPS=15
MAX_REPLAN_ATTEMPTS=3
MAX_TOOL_RETRIES=2

# ------------------------------------------------------------------------------
# 6. FRONTEND (Vite / Vercel)
# ------------------------------------------------------------------------------
# In local dev with Vite proxy, leave empty.
# In Vercel production deployment, set to your Render backend URL:
# VITE_API_URL=https://fluxwarden-api.onrender.com
